# ---------------------------------------------------------------------------
# Database (host "db" is the compose service name)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/secyourflow

# ---------------------------------------------------------------------------
# Redis — backs the job queue, shared cache and the auth rate limiter.
# Host "redis" is the compose service name, NOT localhost: each service runs in
# its own container. Leave unset only for a single-process deployment, in which
# case background jobs run inline and rate limiting falls back to per-process.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Secrets — REPLACE ALL OF THESE. Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=changeme_in_production
NEXTAUTH_SECRET=changeme_in_production
NEXTAUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Encrypts 2FA secrets at rest.
TOTP_ENCRYPTION_KEY=changeme_in_production
# Signs the 2FA session-update payload.
TWO_FACTOR_SESSION_UPDATE_KEY=changeme_in_production
# Encrypts stored scanner, threat-feed and AI provider credentials.
# Changing this makes every previously stored credential undecryptable.
CREDENTIAL_ENCRYPTION_KEY=changeme_in_production

# Bearer token for the automation endpoints (ingest, threat sync, assessments).
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# AI risk analysis
# OLLAMA keeps all data on-premise and needs no key — the right default for an
# air-gapped appliance. Hosted providers: OPENAI, ANTHROPIC, OPENROUTER.
# Per-organization keys can also be set in Settings; these are the fallback.
# ---------------------------------------------------------------------------
AI_PROVIDER=OLLAMA
OLLAMA_ENDPOINT=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Email (invitations, notifications). Leave blank to disable outbound mail.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Optional Google sign-in. Leave both blank to hide the Google button.
# In Google Cloud Console, authorize:
#   http://localhost:3000/api/auth/callback/google
# Replace localhost with the public HTTPS origin in production.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public email/password registration is disabled unless explicitly enabled.
ALLOW_PUBLIC_REGISTRATION=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
