{
  "name": "secyourflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "buildd": "npm run build",
    "start": "next start",
    "start:docker": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:secrets": "bash scripts/gitleaks.sh",
    "security:verify": "tsx scripts/security-verify.ts",
    "security:verify-invitations": "tsx scripts/verify-invitation-security.ts",
    "test": "vitest run",
    "import:framework": "tsx scripts/import-framework-template.ts",
    "import:iso27001": "tsx scripts/import-iso27001-template.ts",
    "import:nistcsf": "tsx scripts/import-nistcsf-template.ts",
    "import:pcidss": "tsx scripts/import-pcidss-template.ts",
    "import:soc2": "tsx scripts/import-soc2-template.ts",
    "worker": "node --import tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.0",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^10.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.17.2",
    "prisma": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.4",
    "react-simple-maps": "^1.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-simple-maps": "^3.0.6",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
