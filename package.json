{
  "name": "secyourflow",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun --bun next dev --webpack -p 3000",
    "dev:workspace": "turbo dev",
    "build": "bun run db:generate && bun --bun next build --webpack",
    "build:workspace": "turbo build",
    "start": "node .next/standalone/server.js",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "analyze": "ANALYZE=true bun run build",
    "worker": "node --import tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:generate": "bun run --cwd packages/database build",
    "db:migrate": "bun run --cwd packages/database migrate:deploy",
    "migrate:deploy": "bun run --cwd packages/database migrate:deploy",
    "security:verify": "tsx scripts/security-verify.ts",
    "security:verify-invitations": "tsx scripts/verify-invitation-security.ts",
    "import:framework": "tsx scripts/import-framework-template.ts",
    "import:iso27001": "tsx scripts/import-iso27001-template.ts",
    "import:nistcsf": "tsx scripts/import-nistcsf-template.ts",
    "import:pcidss": "tsx scripts/import-pcidss-template.ts",
    "import:soc2": "tsx scripts/import-soc2-template.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.4.6",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.5",
    "vitest": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-simple-maps": "^3.0.6",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@repo/analytics": "*",
    "@repo/collaboration": "*",
    "@repo/database": "*",
    "@repo/design-system": "*",
    "@repo/feature-flags": "*",
    "@repo/next-config": "*",
    "@repo/notifications": "*",
    "@repo/observability": "*",
    "@repo/security": "*",
    "@repo/seo": "*",
    "@repo/webhooks": "*",
    "@prisma/client": "7.4.2",
    "@sentry/nextjs": "^10.42.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "fuse.js": "^7.1.0",
    "import-in-the-middle": "^3.0.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "require-in-the-middle": "8.0.1",
    "zod": "^4.3.6",
    "@auth/prisma-adapter": "2.11.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^10.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.17.2",
    "qrcode": "^1.5.4",
    "react-is": "^19.2.4",
    "react-simple-maps": "^1.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "@repo/ai": "*",
    "@repo/cms": "*",
    "@repo/email": "*",
    "@repo/internationalization": "*",
    "@repo/payments": "*",
    "@repo/rate-limit": "*",
    "@repo/storage": "*"
  },
  "overrides": {
    "parse5": "^7.2.1"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true
}
