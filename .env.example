AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secyourflow
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
REDIS_URL=redis://localhost:6379
REAL_API_TESTS=false

# Optional OAuth providers; only fully configured providers appear on the sign-in page.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional Next Forge services (leave blank to keep these integrations disabled).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
BETTERSTACK_API_KEY=
BETTERSTACK_URL=
# Optional Better Stack log ingestion; the Next Forge rewrites are enabled only when both are set.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=
FLAGS_SECRET=
ARCJET_KEY=
